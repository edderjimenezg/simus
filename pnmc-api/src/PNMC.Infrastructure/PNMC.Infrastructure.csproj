<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Una sola versión, usada por la dependencia y por la copia de los modelos. -->
    <VersionDeRapidOcr>4.2.0</VersionDeRapidOcr>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      PNMC-013: la auditoria de NuGet deja de ser un aviso decorativo.
      NU1903 salia en cada compilacion y nadie lo miraba. Escalado a error, la
      restauracion RECHAZA el paquete vulnerable en vez de anunciarlo.
      Solo ALTA (NU1903) y CRITICA (NU1904) rompen la compilacion. BAJA (NU1901)
      y MEDIA (NU1902) siguen saliendo como aviso: se ven, pero un aviso menor
      nuevo en cualquiera de los 106 paquetes del grafo no tumba la compilacion
      de madrugada. NU1900 queda FUERA a proposito: significa "no pude leer el
      origen de auditoria" (red caida) y no debe romper una compilacion sin conexion.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- PNMC-004: saneamiento de HTML por lista blanca (Ganss.Xss), sobre el analizador AngleSharp. -->
    <PackageReference Include="HtmlSanitizer" Version="9.2.995" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="RapidOcrNet" Version="$(VersionDeRapidOcr)" />
    <!--
      AQUI NO VA SQLITE. El proveedor SQLite es de PRUEBAS y su referencia vive
      en PNMC.Api.Tests.csproj, junto con el pin de SQLitePCLRaw que lo acompana.
      Estaba aqui porque AddPnmcInfrastructure registraba `UseSqlite` cuando el
      entorno era "Test": una rama de tres lineas que arrastraba un motor de base
      de datos entero —binario nativo incluido— a cada despliegue de produccion,
      donde no se ejecuta jamas. Si vuelve a hacer falta un proveedor nuevo aqui,
      que sea uno que el servicio use de verdad.
    -->
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Catálogo de claves editables del CMS. Lo genera `npm run cms:catalog` desde
      el registro del front-end, que es la fuente de verdad; viaja incrustado para
      que la siembra no dependa de archivos sueltos en el despliegue.
    -->
    <EmbeddedResource Include="Data/web-content-catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PNMC.Contracts/PNMC.Contracts.csproj" />
    <ProjectReference Include="../PNMC.Domain/PNMC.Domain.csproj" />
  </ItemGroup>

  <!--
    LOS MODELOS DE RECONOCIMIENTO OPTICO TIENEN QUE LLEGAR AL BINARIO QUE SE EJECUTA.

    El paquete los copia con un «target» propio, y eso funciona en ESTE proyecto pero NO cruza un
    ProjectReference: los «build assets» de un paquete no son transitivos. Comprobado: tras añadir la
    dependencia, los modelos aparecían en la salida de Infrastructure y NO en la de PNMC.Api, que es
    el binario que de verdad se arranca. Habría compilado, habría pasado las pruebas de esta capa y
    habría fallado al desplegar, sin más síntoma que un «requiere OCR» permanente.

    Declarándolos aquí como «None» con copia a la salida, viajan solos a todo proyecto que referencie
    esta capa, sin que PNMC.Api tenga que declarar una dependencia que no usa en su código.
  -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)rapidocrnet/$(VersionDeRapidOcr)/models/v5/*.*"
          Link="models/v5/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
