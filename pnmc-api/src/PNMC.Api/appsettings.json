{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "SeedBootstrapUsers": false,
    "StartupTimeoutSeconds": 45,
    "ContinueOnStartupFailure": true
  },
  "ConnectionStrings": {
    "SqlServer": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Importaciones": {
    "Retencion": {
      "DiasPrevisualizacion": 30,
      "IntervaloHoras": 24
    }
  }
}
