# Conexión del API a Azure SQL. Copiar como .env y completar fuera de Git.
AZURE_SQL_SERVER=<servidor>
AZURE_SQL_DATABASE=PNMC_DB
AZURE_SQL_USER=<usuario>
AZURE_SQL_PASSWORD=<clave>
AZURE_SQL_ENCRYPT=true
AZURE_SQL_TRUST_SERVER_CERTIFICATE=false

# La cadena completa es opcional y tiene prioridad sobre los campos anteriores.
AZURE_SQL_CONNECTION_STRING=Server=tcp:<servidor>,1433;Initial Catalog=PNMC_DB;Persist Security Info=False;User ID=<usuario>;Password=<clave>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Origen permitido cuando frontend y API se sirven por separado.
# Cors__AllowedOrigins__0=http://localhost:4300
