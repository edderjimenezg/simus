# Configuracion exclusiva para desarrollo local. Copiar como .env y no versionar.
# Usa una contrasena unica, de al menos 12 caracteres, con mayusculas, minusculas,
# numeros y simbolos. No reutilices credenciales de otros entornos.
PNMC_LOCAL_SA_PASSWORD=<definir_una_contrasena_local_segura>

# Opcionales: se conservan los valores de los scripts si se omiten.
# PNMC_LOCAL_SQL_PORT=14344
# PNMC_LOCAL_DB_NAME=PNMC_LOCAL
# PNMC_LOCAL_API_PORT=8180
# PNMC_LOCAL_WEB_PORT=4300
