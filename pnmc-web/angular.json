{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "schematicCollections": [
      "angular-eslint"
    ]
  },
  "newProjectRoot": "projects",
  "projects": {
    "pnmc-web": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/pnmc-web",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "maplibre-gl-*.mjs",
                "input": "node_modules/maplibre-gl/dist",
                "output": "/"
              },
              {
                "glob": "leaflet.css",
                "input": "node_modules/leaflet/dist",
                "output": "/mapa/leaflet"
              },
              {
                "glob": "images/**/*",
                "input": "node_modules/leaflet/dist",
                "output": "/mapa/leaflet"
              },
              {
                "glob": "maplibre-gl.css",
                "input": "node_modules/maplibre-gl/dist",
                "output": "/mapa/maplibre"
              },
              {
                "glob": "MarkerCluster*.css",
                "input": "node_modules/leaflet.markercluster/dist",
                "output": "/mapa/markercluster"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.production.ts"
                },
                {
                  "replace": "src/agentation.ts",
                  "with": "src/agentation.production.ts"
                },
                {
                  "replace": "src/app/features/admin/admin-login/dev-accounts.ts",
                  "with": "src/app/features/admin/admin-login/dev-accounts.production.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "780kB",
                  "maximumError": "900kB"
                },
                {
                  "type": "anyScript",
                  "maximumWarning": "1450kB",
                  "maximumError": "1600kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "14kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "analisis": {
              "sourceMap": {
                "scripts": true,
                "styles": true,
                "hidden": false,
                "vendor": true
              },
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json",
            "prebundle": {
              "exclude": [
                "maplibre-gl",
                "@maplibre/maplibre-gl-leaflet"
              ]
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "pnmc-web:build:production"
            },
            "development": {
              "buildTarget": "pnmc-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "leaflet.css",
                "input": "node_modules/leaflet/dist",
                "output": "/mapa/leaflet"
              },
              {
                "glob": "images/**/*",
                "input": "node_modules/leaflet/dist",
                "output": "/mapa/leaflet"
              },
              {
                "glob": "maplibre-gl.css",
                "input": "node_modules/maplibre-gl/dist",
                "output": "/mapa/maplibre"
              },
              {
                "glob": "MarkerCluster*.css",
                "input": "node_modules/leaflet.markercluster/dist",
                "output": "/mapa/markercluster"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  }
}
