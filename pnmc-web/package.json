{
  "name": "pnmc-web",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4300",
    "agentation": "agentation-mcp server",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test",
    "lint": "ng lint --max-warnings 411",
    "cms:catalog": "node tools/export-content-catalog.mjs",
    "media:optimize": "node tools/optimize-images.mjs",
    "cms:preflight": "node tools/preflight-publicacion.mjs",
    "cms:huerfanas": "node tools/claves-sin-lector.mjs",
    "cms:reservas": "node tools/reservas-de-plantilla.mjs",
    "cms:cobertura": "node tools/medir-cobertura.mjs",
    "cms:snapshot": "node tools/snapshot-rendered-text.mjs",
    "cms:snapshot:check": "node tools/snapshot-rendered-text.mjs --check",
    "e2e": "playwright test",
    "e2e:trace": "playwright show-trace",
    "e2e:ci": "playwright test --config playwright.ci.config.ts",
    "trinquete": "npm run trinquete:any && npm run trinquete:interfaz && npm run consola:secciones",
    "trinquete:any": "node trinquete/trinquete-any.mjs",
    "trinquete:interfaz": "node trinquete/trinquete-interfaz.mjs",
    "trinquete:prueba": "node trinquete/trinquete-any.prueba.mjs && node trinquete/trinquete-interfaz.prueba.mjs",
    "auditoria:interfaz": "playwright test --config playwright.audit.config.ts",
    "auditoria:interfaz:informe": "node e2e-audit/consolidar.mjs",
    "cms:fabrica": "node tools/refrescar-copia-de-fabrica.mjs",
    "cms:ciclo": "node tools/prueba-ciclo-cms.mjs",
    "mapa:capa-base": "node tools/comprobar-capa-base.mjs",
    "mapa:territorios": "node tools/comprobar-territorios.mjs",
    "mapa:tarjeta": "node tools/comprobar-tarjeta-municipio.mjs",
    "mapa:rotulos": "node tools/comprobar-rotulos.mjs",
    "mapa:paneles": "node tools/comprobar-paneles.mjs",
    "mapa:modo": "node tools/comprobar-modo-practicas.mjs",
    "mapa:atajo": "node tools/comprobar-atajo-directorio.mjs",
    "mapa:velocidad": "node tools/comprobar-velocidad-mapa.mjs",
    "media:presupuesto": "node tools/presupuesto-de-imagenes.mjs",
    "consola:secciones": "node tools/secciones-sin-panel.mjs"
  },
  "private": true,
  "overrides": {
    "qs": "6.16.0",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/forms": "21.2.23",
    "@angular/platform-browser": "21.2.23",
    "@angular/platform-browser-dynamic": "21.2.23",
    "@angular/router": "21.2.23",
    "@lucide/angular": "^1.21.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "maplibre-gl": "6.9.0",
    "rxjs": "~7.8.0",
    "topojson-client": "^3.1.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.23",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/topojson-client": "^3.1.5",
    "agentation": "^3.0.2",
    "agentation-mcp": "^1.2.0",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.15",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.59.2"
  }
}
